<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Appointment List View -->
    <record id="view_appointment_tree" model="ir.ui.view">
        <field name="name">stylehub.appointment.tree</field>
        <field name="model">stylehub.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments" decoration-info="state=='draft'" 
                  decoration-success="state=='confirmed'" decoration-muted="state=='cancelled'">
                <field name="start_datetime"/>
                <field name="customer_id"/>
                <field name="stylist_id"/>
                <field name="total_duration" widget="float_time"/>
                <field name="end_datetime"/>
                <field name="total_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge" 
                       decoration-info="state=='draft'"
                       decoration-warning="state=='confirmed'" 
                       decoration-success="state=='done'"
                       decoration-danger="state=='cancelled'"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Appointment Form View -->
    <record id="view_appointment_form" model="ir.ui.view">
        <field name="name">stylehub.appointment.form</field>
        <field name="model">stylehub.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
                <header>
                    <button name="action_confirm" string="Confirm Appointment" 
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_done" string="Mark as Done" 
                            type="object" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" 
                            type="object"
                            invisible="state in ['done', 'cancelled']"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" 
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Appointment Details">
                            <field name="customer_id" 
                                   context="{'res_partner_search_mode': 'customer'}"
                                   options="{'no_create_edit': True}"/>
                            <field name="stylist_id"/>
                            <field name="start_datetime"/>
                        </group>
                        <group string="Timing">
                            <field name="total_duration" widget="float_time" readonly="1"/>
                            <field name="end_datetime" readonly="1" 
                                   class="fw-bold text-success"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Services" name="services">
                            <field name="line_ids">
                                <list string="Services" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="service_id"/>
                                    <field name="duration" widget="float_time" readonly="1"/>
                                    <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_price" widget="monetary" 
                                       class="oe_subtotal_footer_separator fw-bold"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Special requests, customer preferences, etc..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Appointment Calendar View -->
    <record id="view_appointment_calendar" model="ir.ui.view">
        <field name="name">stylehub.appointment.calendar</field>
        <field name="model">stylehub.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments Calendar" 
                      date_start="start_datetime" 
                      date_stop="end_datetime"
                      color="stylist_id"
                      mode="week"
                      event_open_popup="true"
                      quick_create="0">
                <field name="customer_id"/>
                <field name="stylist_id"/>
                <field name="state" invisible="1"/>
            </calendar>
        </field>
    </record>

    <!-- Appointment Kanban View (by Status) -->
    <record id="view_appointment_kanban" model="ir.ui.view">
        <field name="name">stylehub.appointment.kanban</field>
        <field name="model">stylehub.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="customer_id"/>
                <field name="stylist_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="total_price"/>
                <field name="state"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="customer_id"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-scissors"/> <field name="stylist_id"/>
                                </div>
                                <div>
                                    <i class="fa fa-clock-o"/> 
                                    <field name="start_datetime" widget="datetime"/>
                                </div>
                                <div class="text-muted">
                                    Ends: <field name="end_datetime" widget="datetime"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <strong class="text-success">
                                        <field name="total_price" widget="monetary"/>
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Appointment Search View -->
    <record id="view_appointment_search" model="ir.ui.view">
        <field name="name">stylehub.appointment.search</field>
        <field name="model">stylehub.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointments">
                <field name="customer_id"/>
                <field name="stylist_id"/>
                <field name="start_datetime"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Done" name="filter_done" domain="[('state','=','done')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Today" name="filter_today" 
                        domain="[('start_datetime','&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('start_datetime','&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="This Week" name="filter_week" 
                        domain="[('start_datetime','&gt;=', (context_today() + relativedelta(weeks=-1, weekday=0)).strftime('%Y-%m-%d')),
                                 ('start_datetime','&lt;', (context_today() + relativedelta(weeks=0, weekday=6)).strftime('%Y-%m-%d 23:59:59'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_customer" context="{'group_by':'customer_id'}"/>
                    <filter string="Stylist" name="group_stylist" context="{'group_by':'stylist_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Start Date" name="group_start_date" context="{'group_by':'start_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Appointment Action -->
    <record id="action_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">stylehub.appointment</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule your first appointment!
            </p>
            <p>
                Click the CREATE button to book a new appointment. 
                The system will automatically calculate the end time and prevent overlapping bookings.
            </p>
        </field>
    </record>
</odoo>
