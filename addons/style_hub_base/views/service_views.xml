<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Service List View -->
    <record id="view_service_tree" model="ir.ui.view">
        <field name="name">stylehub.service.tree</field>
        <field name="model">stylehub.service</field>
        <field name="arch" type="xml">
            <list string="Services">
                <field name="name"/>
                <field name="duration" widget="float_time"/>
                <field name="base_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Service Form View -->
    <record id="view_service_form" model="ir.ui.view">
        <field name="name">stylehub.service.form</field>
        <field name="model">stylehub.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="active" widget="boolean_button" options="{'terminology': 'active'}"/>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g., Men's Haircut"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                        <group>
                            <field name="base_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Additional details about this service..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Service Action -->
    <record id="action_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">stylehub.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first service!
            </p>
            <p>
                Define all the services offered at your salon with their duration and pricing.
            </p>
        </field>
    </record>
</odoo>
