<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Service List View -->
    <record id="view_service_list" model="ir.ui.view">
        <field name="name">stylehub.service.list</field>
        <field name="model">stylehub.service</field>
        <field name="arch" type="xml">
            <list string="Servicios">
                <field name="name"/>
                <field name="duration" widget="float_time"/>
                <field name="base_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Service Form View -->
    <record id="view_service_form" model="ir.ui.view">
        <field name="name">stylehub.service.form</field>
        <field name="model">stylehub.service</field>
        <field name="arch" type="xml">
            <form string="Servicio">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="ej: Corte de Hombre"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                        <group>
                            <field name="base_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Detalles adicionales sobre este servicio..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Service Action -->
    <record id="action_service" model="ir.actions.act_window">
        <field name="name">Servicios</field>
        <field name="res_model">stylehub.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primer servicio!
            </p>
            <p>
                Define todos los servicios ofrecidos en tu salón con su duración y precio.
            </p>
        </field>
    </record>
</odoo>
